# Sao chép thành .env rồi điền giá trị. KHÔNG đưa file .env lên git.
# Biến có tiền tố NEXT_PUBLIC_ sẽ lộ ra trình duyệt — chỉ đặt khoá công khai ở đó.

# ── Gommo (qua tài khoản 79ai) — chỉ dùng ở server ──
GOMMO_ACCESS_TOKEN=
GOMMO_DOMAIN=

# ── Supabase (Project Settings → API Keys) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Khoá secret (hoặc service_role ở project cũ): bỏ qua RLS, chỉ server dùng.
SUPABASE_SECRET_KEY=

# ── PayOS (trang quản lý kênh thanh toán) ──
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ── Địa chỉ công khai của site (returnUrl của PayOS) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Chủ nhóm và nhóm riêng (lib/access.ts) ──
# Email Google của chủ nhóm: làm được mọi việc ở trang /admin, kể cả cấp credit và thêm quản trị viên.
# Quản trị viên và thành viên mời trên trang /admin (bảng gaia_members, supabase/migrations/0004_members.sql).
GAIA_OWNER_EMAIL=
# Mặc định là nhóm riêng: chỉ người được mời đăng nhập, tắt nạp tiền. Đặt 1 khi mở bán công khai
# (ai có tài khoản Google cũng vào được, bật nạp tiền PayOS).
GAIA_OPEN_SIGNUP=

# ── Cron mỗi ngày trên Vercel (vercel.json → /api/cron/daily) ──
# Chuỗi ngẫu nhiên ≥ 16 ký tự. Vercel tự gửi kèm khi gọi cron; thiếu biến này thì cron bị từ chối (401).
CRON_SECRET=

# ── Giá (tuỳ chọn, đây là mặc định) ──
# 1 credit GAIA = 1đ. credit GAIA = ceil(credit Gommo × GAIA_COST_PER_GOMMO_CREDIT × GAIA_MARKUP)
GAIA_COST_PER_GOMMO_CREDIT=1
GAIA_MARKUP=1.5
# Đặt 1 sau khi đã kiểm chứng `credit`/`credit_fee` của Gommo là giá thật: hoàn chênh lệch khi giá thật thấp hơn.
GAIA_SETTLE_ACTUAL_COST=0

# ── Dịch prompt video tiếng Việt: gommo (translate_to_en, miễn phí) | claude (chưa làm) ──
PROMPT_TRANSLATOR=gommo
